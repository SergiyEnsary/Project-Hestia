# Required — generate with: openssl rand -hex 32
HESTIA_API_TOKEN=your-token-here

# Module secrets (never commit real values)
# CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/your-private-url/basic.ics
# HOME_ASSISTANT_URL=https://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=your-long-lived-access-token
# MQTT_USERNAME=
# MQTT_PASSWORD=
# IRIS_FROM_ADDRESS=hestia@example.com

# Optional AWS (only when aws.enabled: true in config.yaml, or Iris SES)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
